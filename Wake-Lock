<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>Portaria TV</title>

  <style>
    * {
      box-sizing: border-box;
    }

    html,
    body {
      margin: 0;
      padding: 0;
      width: 100%;
      height: 100%;
      overflow: hidden;
      background: #000;
    }

    body {
      font-family: Arial, sans-serif;
    }

    .layout {
      width: 100vw;
      height: 100vh;

      display: grid;

      grid-template-columns: 72% 28%;
      grid-template-rows: 78% 22%;

      gap: 2px;

      background: #111;
    }

    .panel {
      position: relative;
      overflow: hidden;
      background: #000;
    }

    .portaria {
      grid-column: 1;
      grid-row: 1 / 3;
    }

    .excel {
      grid-column: 2;
      grid-row: 1;
    }

    .clock {
      grid-column: 2;
      grid-row: 2;
    }

    iframe {
      width: 100%;
      height: 100%;
      border: 0;
      display: block;
      background: #fff;
    }

    .label {
      position: absolute;

      z-index: 10;

      top: 4px;
      left: 6px;

      padding: 3px 7px;

      border-radius: 3px;

      background: rgba(0, 0, 0, 0.65);
      color: #fff;

      font-size: 11px;

      pointer-events: none;
    }

    #wakeStatus {
      position: fixed;

      z-index: 999;

      right: 5px;
      bottom: 5px;

      color: rgba(255, 255, 255, 0.35);

      font-size: 10px;

      pointer-events: none;
    }

    /* Celular / tela vertical */
    @media (orientation: portrait) {

      .layout {
        grid-template-columns: 1fr;
        grid-template-rows: 65% 25% 10%;
      }

      .portaria {
        grid-column: 1;
        grid-row: 1;
      }

      .excel {
        grid-column: 1;
        grid-row: 2;
      }

      .clock {
        grid-column: 1;
        grid-row: 3;
      }
    }
  </style>
</head>

<body>

  <main class="layout">

    <!-- PORTARIA -->
    <section class="panel portaria">

      <span class="label">
        PORTARIA
      </span>

      <iframe
        src="https://contac.cgsindinvest.com.br/Visita/view"
        title="Sistema da Portaria"
        allow="fullscreen; autoplay"
        referrerpolicy="strict-origin-when-cross-origin">
      </iframe>

    </section>


    <!-- EXCEL -->
    <section class="panel excel">

      <span class="label">
        PRIORIDADES
      </span>

      <iframe
        src="https://juliosimoes.sharepoint.com/:x:/s/Filial_Contagem/IQChUV0YwuxoR726S0I5tLjVAUPetl8PIAwBdqXfbCyrmQs?e=YECGVD"
        title="Excel Prioridades"
        allow="fullscreen">
      </iframe>

    </section>


    <!-- RELÓGIO -->
    <section class="panel clock">

      <span class="label">
        RELÓGIO
      </span>

      <iframe
        src="https://digitalclock.live/flip-clock/"
        title="Relógio"
        allow="fullscreen">
      </iframe>

    </section>

  </main>


  <!-- INDICADOR DO KEEP AWAKE -->
  <div id="wakeStatus">
    Wake Lock: iniciando...
  </div>


  <script>

    let wakeLock = null;

    const status =
      document.getElementById("wakeStatus");


    async function requestWakeLock() {

      try {

        /* Verifica se o navegador suporta Wake Lock */

        if (!("wakeLock" in navigator)) {

          status.textContent =
            "Wake Lock: não suportado";

          return;
        }


        /* Solicita que a tela permaneça ligada */

        wakeLock =
          await navigator.wakeLock.request("screen");


        status.textContent =
          "Wake Lock: ativo";


        /* Se o sistema liberar o Wake Lock */

        wakeLock.addEventListener(
          "release",
          () => {

            status.textContent =
              "Wake Lock: liberado";

            wakeLock = null;

          }
        );


      } catch (error) {

        status.textContent =
          "Wake Lock: indisponível";

      }

    }


    /* Solicita assim que a página abre */

    requestWakeLock();


    /* Tenta novamente quando a página volta a ficar visível */

    document.addEventListener(
      "visibilitychange",
      () => {

        if (
          document.visibilityState === "visible"
        ) {

          requestWakeLock();

        }

      }
    );


    /* Verifica a cada 30 segundos */

    setInterval(
      () => {

        if (
          !wakeLock &&
          document.visibilityState === "visible"
        ) {

          requestWakeLock();

        }

      },
      30000
    );

  </script>

</body>
</html>
